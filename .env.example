# ── Admin dashboard (/admin) ─────────────────────────────────────────
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Authorised accounts, separated by ";". Each entry: email:role:salt:hash
# (role = owner | viewer). Create entries with:
#   node scripts/create-admin-user.mjs someone@example.com owner
# or from the dashboard page "الحسابات" (owner accounts only).
ADMIN_USERS=

# ── Visit statistics store (production) ──────────────────────────────
# Added automatically when an Upstash Redis database is connected to the
# Vercel project (Vercel → Storage / Marketplace → Upstash Redis).
# Leave empty locally: development uses .data/analytics.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
